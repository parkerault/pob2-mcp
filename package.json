{
  "name": "pob2-mcp-server",
  "version": "0.2.2",
  "description": "MCP server for Path of Building - PoE2 integration",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^4.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "zod-to-json-schema": "3.24.6"
  },
  "packageManager": "pnpm@11.6.0"
}
